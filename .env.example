# LOCAL_API_KEY: Required key if utilizing Gemini services.
# Injected at runtime from environment secrets.
GEMINI_API_KEY="MY_LOCAL_API_KEY"

# APP_URL: The URL where this application is hosted.
# Injected at runtime with the service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
